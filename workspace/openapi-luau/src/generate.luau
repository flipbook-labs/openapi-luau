local collectOperations = require("./collectOperations")
local createTypeContext = require("./createTypeContext")
local nameOperations = require("./nameOperations")
local quote = require("./quote")
local renderDocComment = require("./renderDocComment")
local renderOperation = require("./renderOperation")
local renderType = require("./renderType")
local toPascalCase = require("./toPascalCase")
local types = require("./types")

type GeneratedFiles = types.GeneratedFiles
type Schema = types.Schema
type Spec = types.Spec

export type GenerateOptions = {
	-- The tag whose operations become the client. Only operations with this as
	-- their first tag are included.
	tag: string,
	-- The require path generated code uses to load openapi-runtime.
	runtimeRequire: string,
}

local function sortedKeys<T>(map: { [string]: T }): { string }
	local keys: { string } = {}
	for key in map do
		table.insert(keys, key)
	end
	table.sort(keys)
	return keys
end

--[[
	Generates a client for one tag of an OpenAPI document. The result maps file
	names to contents: `init.luau` holds a function per operation, and
	`types.luau` holds the component schemas those operations use. When the
	operations use no components, `types.luau` is left out.
]]
local function generate(spec: Spec, options: GenerateOptions): GeneratedFiles
	local operations = nameOperations(collectOperations(spec, options.tag))
	if #operations == 0 then
		error(`no operations have '{options.tag}' as their first tag`, 0)
	end

	-- The header is a one-line comment, so line breaks in the title or version
	-- become spaces. Otherwise the rest of the text would land outside the
	-- comment as code.
	local info: { title: string?, version: string? } = spec.info or {}
	local source = `{info.title or "an OpenAPI document"} {info.version or ""}`
	source = source:gsub("%s+", " "):gsub("^ ", ""):gsub(" $", "")
	local header = `-- Generated by openapi-luau from {source}. Do not edit.\n`

	local reservedNames: { string } = { "Client" }
	for _, operation in operations do
		table.insert(reservedNames, toPascalCase(operation.name) .. "Params")
	end

	local clientContext = createTypeContext(spec, "types.", reservedNames)
	local operationChunks: { string } = {}
	for _, operation in operations do
		table.insert(operationChunks, renderOperation(operation, clientContext))
	end

	-- Component types can reference further components, so keep rendering
	-- until every referenced component has a definition.
	local schemas = if spec.components then spec.components.schemas else nil
	local typesContext = createTypeContext(spec, "", reservedNames)
	for name in clientContext.referenced do
		typesContext.referenced[name] = true
	end
	local definitions: { [string]: string } = {}
	local hasPending = true
	while hasPending do
		hasPending = false
		for name in table.clone(typesContext.referenced) do
			if definitions[name] == nil then
				hasPending = true
				local schema = (schemas or {})[name] :: Schema
				local text = renderType(schema, typesContext, 0)
				definitions[name] = renderDocComment(schema.description, "")
					.. `export type {typesContext.typeNames[name]} = {text}\n`
			end
		end
	end

	local typeChunks: { string } = { header }
	local reexports: { string } = {}
	for _, name in sortedKeys(definitions) do
		table.insert(typeChunks, "\n" .. definitions[name])
		local typeName = typesContext.typeNames[name]
		table.insert(reexports, `export type {typeName} = types.{typeName}\n`)
	end
	table.insert(typeChunks, "\nreturn nil\n")

	local clientChunks: { string } = {
		header,
		"\n",
		`local runtime = require({quote(options.runtimeRequire)})\n`,
	}
	if #reexports > 0 then
		table.insert(clientChunks, `local types = require("@self/types")\n`)
	end
	table.insert(clientChunks, "\nexport type Client = runtime.Client\n")
	for _, line in reexports do
		table.insert(clientChunks, line)
	end
	for _, chunk in operationChunks do
		table.insert(clientChunks, "\n" .. chunk)
	end

	local exportLines: { string } = {}
	for _, operation in operations do
		table.insert(exportLines, `\t{operation.name} = {operation.name},`)
	end
	table.insert(clientChunks, `\nreturn \{\n{table.concat(exportLines, "\n")}\n}\n`)

	local files: GeneratedFiles = {
		["init.luau"] = table.concat(clientChunks),
	}
	if #reexports > 0 then
		files["types.luau"] = table.concat(typeChunks)
	end
	return files
end

return generate
