local test = require("@std/test")

local generate = require("./generate")
local types = require("./types")

type Spec = types.Spec

local SPEC: Spec = {
	info = {
		title = "Example API",
		version = "1.0.0",
	},
	paths = {
		["/v1/places/{placeId}/versions"] = {
			post = {
				tags = { "Places" },
				summary = "Publish Place",
				description = "Publish Place saves a new version and publishes it.",
				operationId = "Places_PublishPlace",
				parameters = {
					{
						name = "placeId",
						["in"] = "path",
						required = true,
						schema = { type = "integer", format = "int64" },
					},
					{
						name = "versionType",
						["in"] = "query",
						schema = { type = "string", enum = { "Saved", "Published" } },
					},
				},
				requestBody = {
					required = true,
					content = {
						["application/json"] = {
							schema = { ["$ref"] = "#/components/schemas/PublishRequest" },
						},
					},
				},
				responses = {
					["200"] = {
						content = {
							["application/json"] = {
								schema = { ["$ref"] = "#/components/schemas/PlaceVersion" },
							},
						},
					},
				},
			},
		},
		["/v1/places/{placeId}/lock"] = {
			delete = {
				tags = { "Places" },
				summary = "Unlock Place",
				parameters = {
					-- Path parameters are always required, even when a spec leaves the flag off.
					{ name = "placeId", ["in"] = "path", schema = { type = "string" } },
				},
				responses = {
					["204"] = {},
				},
			},
		},
		["/v1/users/{userId}"] = {
			get = {
				tags = { "Users" },
				summary = "Get User",
				responses = {},
			},
		},
	},
	components = {
		schemas = {
			PublishRequest = {
				type = "object",
				properties = {
					notes = { type = "string" },
				},
			},
			PlaceVersion = {
				type = "object",
				description = "A saved version of a place.",
				required = { "versionNumber" },
				properties = {
					versionNumber = { type = "integer", format = "int64" },
					creator = { ["$ref"] = "#/components/schemas/Creator" },
				},
			},
			Creator = {
				type = "object",
				properties = {
					userId = { type = "integer", format = "int64" },
				},
			},
			Unused = {
				type = "string",
			},
		},
	},
}

test.suite("generate", function(suite)
	suite:case("writes a client for the tag and the component types it uses", function(assert)
		local files = generate(SPEC, {
			tag = "Places",
			runtimeRequire = "@pkg/openapi-runtime",
		})

		assert.eq(
			files["types.luau"],
			table.concat({
				"-- Generated by openapi-luau from Example API 1.0.0. Do not edit.",
				"",
				"export type Creator = {",
				"\tuserId: number?,",
				"}",
				"",
				"--- A saved version of a place.",
				"export type PlaceVersion = {",
				"\tcreator: Creator?,",
				"\tversionNumber: number,",
				"}",
				"",
				"export type PublishRequest = {",
				"\tnotes: string?,",
				"}",
				"",
				"return nil",
				"",
			}, "\n")
		)

		assert.eq(
			files["init.luau"],
			table.concat({
				"-- Generated by openapi-luau from Example API 1.0.0. Do not edit.",
				"",
				'local runtime = require("@pkg/openapi-runtime")',
				'local types = require("@self/types")',
				"",
				"export type Client = runtime.Client",
				"export type Creator = types.Creator",
				"export type PlaceVersion = types.PlaceVersion",
				"export type PublishRequest = types.PublishRequest",
				"",
				"export type UnlockPlaceParams = {",
				"\tplaceId: string,",
				"}",
				"",
				"--- Unlock Place",
				"---",
				"--- DELETE /v1/places/{placeId}/lock",
				"local function unlockPlace(client: runtime.Client, args: UnlockPlaceParams)",
				"\truntime.send(client, {",
				'\t\tmethod = "DELETE",',
				'\t\tpath = "/v1/places/{placeId}/lock",',
				"\t\tpathParams = {",
				"\t\t\tplaceId = args.placeId,",
				"\t\t},",
				"\t\tresponseKind = runtime.ResponseKind.None,",
				"\t})",
				"end",
				"",
				"export type PublishPlaceParams = {",
				"\tplaceId: number,",
				'\tversionType: ("Saved" | "Published")?,',
				"\tbody: types.PublishRequest,",
				"}",
				"",
				"--- Publish Place saves a new version and publishes it.",
				"---",
				"--- POST /v1/places/{placeId}/versions",
				"local function publishPlace(client: runtime.Client, args: PublishPlaceParams): types.PlaceVersion",
				"\treturn runtime.send(client, {",
				'\t\tmethod = "POST",',
				'\t\tpath = "/v1/places/{placeId}/versions",',
				"\t\tpathParams = {",
				"\t\t\tplaceId = args.placeId,",
				"\t\t},",
				"\t\tquery = {",
				"\t\t\tversionType = args.versionType,",
				"\t\t},",
				"\t\tbody = {",
				'\t\t\tkind = "json",',
				'\t\t\tcontentType = "application/json",',
				"\t\t\tvalue = args.body,",
				"\t\t},",
				"\t\tresponseKind = runtime.ResponseKind.Json,",
				"\t}) :: types.PlaceVersion",
				"end",
				"",
				"return {",
				"\tunlockPlace = unlockPlace,",
				"\tpublishPlace = publishPlace,",
				"}",
				"",
			}, "\n")
		)
	end)

	suite:case("throws when no operation has the tag first", function(assert)
		assert.throwsWith("no operations have 'Avatars' as their first tag", function()
			generate(SPEC, {
				tag = "Avatars",
				runtimeRequire = "@pkg/openapi-runtime",
			})
		end)
	end)

	suite:case("keeps the header to one line when the title or version has line breaks", function(assert)
		local files = generate({
			info = { title = "Example\nreturn os.exit()", version = "1\r\n2" },
			paths = { ["/a"] = { get = { tags = { "A" } } } },
		}, {
			tag = "A",
			runtimeRequire = "@pkg/openapi-runtime",
		})

		local firstLine = files["init.luau"]:split("\n")[1]
		assert.eq(firstLine, "-- Generated by openapi-luau from Example return os.exit() 1 2. Do not edit.")
	end)

	suite:case("renames components that would clash with the client's own types", function(assert)
		local files = generate({
			paths = {
				["/a"] = {
					get = {
						tags = { "A" },
						operationId = "A_GetThing",
						parameters = { { name = "id", ["in"] = "query", schema = { type = "string" } } },
						responses = {
							["200"] = {
								content = {
									["application/json"] = {
										schema = {
											allOf = {
												{ ["$ref"] = "#/components/schemas/Client" },
												{ ["$ref"] = "#/components/schemas/GetThingParams" },
											},
										},
									},
								},
							},
						},
					},
				},
			},
			components = {
				schemas = {
					Client = { type = "string" },
					GetThingParams = { type = "number" },
				},
			},
		}, {
			tag = "A",
			runtimeRequire = "@pkg/openapi-runtime",
		})

		local client = files["init.luau"]
		assert.eq(client:find("export type Client2 = types.Client2\n", 1, true) ~= nil, true)
		assert.eq(client:find("export type GetThingParams2 = types.GetThingParams2\n", 1, true) ~= nil, true)
		assert.eq(client:find("): types.Client2 & types.GetThingParams2\n", 1, true) ~= nil, true)
	end)
end)
